# ==============================================================================
# INC 2026 Candidate Assessment Platform - Environment Configuration Template
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - Variables starting with NEXT_PUBLIC_ are baked into client-side JS bundles.
# - Variables WITHOUT NEXT_PUBLIC_ are privileged, server-only secrets.
#   NEVER prefix SUPABASE_SERVICE_ROLE_KEY or GEMINI_API_KEY with NEXT_PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SAFE (PUBLIC) SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Obtain from: Supabase Dashboard -> Project Settings -> API
# Safe to expose to the browser; protected by PostgreSQL Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# ------------------------------------------------------------------------------
# 2. PRIVILEGED SERVER-ONLY SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Obtain from: Supabase Dashboard -> Project Settings -> API (service_role secret)
# CRITICAL SECRET: Bypasses Row Level Security. Used strictly server-side for:
# - System administration
# - AI evaluation ingestion
# - Audit log persistence
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-key

# ------------------------------------------------------------------------------
# 3. AI EVALUATION CONFIGURATION (SERVER-ONLY)
# ------------------------------------------------------------------------------
# Obtain from: Google AI Studio (https://aistudio.google.com/)
# Used server-side for rubric evaluation of Problem Analysis & Algorithm Builder answers.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. ADMINISTRATOR AUTHORIZATION (SERVER-ONLY)
# ------------------------------------------------------------------------------
# Comma-separated list of institutional student emails granted administrative privileges.
# Checked strictly on the server against verified Supabase Auth user emails.
ADMIN_EMAILS=coach@student.president.ac.id,admin@student.president.ac.id

# ------------------------------------------------------------------------------
# 5. APPLICATION BASE URL (PUBLIC)
# ------------------------------------------------------------------------------
# Local development: http://localhost:3000
# Netlify Staging: https://your-site-name.netlify.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 6. CONFIDENTIAL REPORTING & NOTIFICATION (SERVER-ONLY)
# ------------------------------------------------------------------------------
# Email to receive consolidated PDF reports when assessment closing deadline passes
ADMIN_REPORT_EMAIL=admin@student.president.ac.id

# Optional Resend API credentials for automated email notification delivery
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Bearer secret for authenticating Netlify scheduled cron functions
CRON_SECRET=

# ------------------------------------------------------------------------------
# 7. OPTIONAL: JUDGE0 SANDBOXED C++ EXECUTION (SERVER-ONLY)
# ------------------------------------------------------------------------------
# If left empty, the platform securely stores C++ submissions and marks automated execution
# as unavailable without fabricating results.
JUDGE0_API_URL=
JUDGE0_API_KEY=
